<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>ModuVision</title>

  <!-- Shared navbar styles (if needed) -->
  <link rel="stylesheet" href="/css/Navbar.css">

  <link rel="stylesheet" href="/css/styles.css">

  <link rel="icon" href="/materials/logo2.png" type="image/x-icon">
</head>
<body>

  <!-- NAVBAR -->
  <%- include("partials/navbar") %>


  <!-- HERO SECTION -->
  <section class="hero">
    <video autoplay muted loop playsinline class="hero-video">
      <source src="/materials/background.mp4" type="video/mp4">
    </video>

    <div class="hero-overlay"></div>

    <div class="hero-content">
      <h1>Modular Intelligence for Retail Vision</h1>
      <p>
        ModuVision is a flexible AI vision platform that enables retail environments
        to dynamically compose intelligent visual workflows.
      </p>

      <div class="hero-buttons">
        <a href="/auth?mode=signup" class="navbar-btn">Get Started</a>
        <a href="/auth?mode=login" class="navbar-btn outline">Login</a>
      </div>
    </div>
  </section>


  <!-- ABOUT SECTION -->
  <section class="about">
    <h2>About ModuVision</h2>

    <p class="about-intro">
      ModuVision rethinks how computer vision systems are built. Instead of rigid,
      single-purpose pipelines, we introduce a modular intelligence layer that adapts
      to retail environments in real time.
    </p>

    <div class="about-modules">

      <div class="module-card">
        <h3>🔍 Detect</h3>
        <p>
          Independent vision modules identify products, shelves, customers,
          and events with high precision.
        </p>
      </div>

      <div class="module-card">
        <h3>🧠 Analyze</h3>
        <p>
          Each module processes visual data separately, enabling specialized
          reasoning without system-wide retraining.
        </p>
      </div>

      <div class="module-card">
        <h3>🧩 Compose</h3>
        <p>
          Modules are dynamically assembled into task-specific pipelines using
          a Neural Module Network architecture.
        </p>
      </div>

      <div class="module-card">
        <h3>⚡ Adapt</h3>
        <p>
          Retail systems evolve instantly — new tasks, new goals, no downtime,
          and no full retraining cycles.
        </p>
      </div>

    </div>
  </section>


  <!-- JOIN SECTION -->
  <section class="join">
    <h2>Join the Future of Intelligent Retail Vision</h2>
    <p>Start building, experimenting, and deploying smarter systems today.</p>

    <div class="join-buttons">
      <a href="/auth?mode=signup" class="navbar-btn">Create Account</a>
      <a href="/auth?mode=login" class="navbar-btn outline">Login</a>
    </div>
  </section>

</body>
</html>
