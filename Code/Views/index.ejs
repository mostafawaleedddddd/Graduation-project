<script>
/* ─── CURSOR ─── */
const cursor = document.getElementById('cursor');
const ring = document.getElementById('cursorRing');
let mx = 0, my = 0, rx = 0, ry = 0;
document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
function animCursor() {
  cursor.style.transform = `translate(${mx-6}px, ${my-6}px)`;
  rx += (mx - rx) * 0.12;
  ry += (my - ry) * 0.12;
  ring.style.transform = `translate(${rx-20}px, ${ry-20}px)`;
  requestAnimationFrame(animCursor);
}
animCursor();
document.querySelectorAll('a, button, .mod-block').forEach(el => {
  el.addEventListener('mouseenter', () => ring.style.transform += ' scale(1.8)');
  el.addEventListener('mouseleave', () => {});
});

/* ─── NAVBAR SCROLL ─── */
const navbar = document.getElementById('navbar');
window.addEventListener('scroll', () => {
  navbar.classList.toggle('scrolled', window.scrollY > 60);
});

/* ─── HERO THREE.JS ─── */
(function() {
  const canvas = document.getElementById('hero-canvas');
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 8;

  // Floating boxes (pipeline nodes)
  const geoms = [
    new THREE.BoxGeometry(0.7, 0.7, 0.7),
    new THREE.BoxGeometry(0.5, 0.5, 0.5),
    new THREE.BoxGeometry(0.9, 0.4, 0.4),
  ];
  const neonMat1 = new THREE.MeshBasicMaterial({ color: 0x00C6FF, wireframe: true, opacity: 0.5, transparent: true });
  const neonMat2 = new THREE.MeshBasicMaterial({ color: 0xFF00CC, wireframe: true, opacity: 0.4, transparent: true });
  const neonMat3 = new THREE.MeshBasicMaterial({ color: 0x8E2DE2, wireframe: true, opacity: 0.35, transparent: true });
  const mats = [neonMat1, neonMat2, neonMat3];

  const boxes = [];
  for (let i = 0; i < 22; i++) {
    const g = geoms[i % geoms.length];
    const m = mats[i % mats.length];
    const mesh = new THREE.Mesh(g, m);
    mesh.position.set((Math.random() - 0.5) * 18, (Math.random() - 0.5) * 10, (Math.random() - 0.5) * 6);
    mesh.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
    mesh.userData = { vy: (Math.random() - 0.5) * 0.003, vr: (Math.random() - 0.5) * 0.005, vry: (Math.random() - 0.5) * 0.008 };
    scene.add(mesh);
    boxes.push(mesh);
  }

  // Particles
  const ptGeo = new THREE.BufferGeometry();
  const ptCount = 300;
  const ptPos = new Float32Array(ptCount * 3);
  for (let i = 0; i < ptCount * 3; i++) ptPos[i] = (Math.random() - 0.5) * 30;
  ptGeo.setAttribute('position', new THREE.BufferAttribute(ptPos, 3));
  const ptMat = new THREE.PointsMaterial({ color: 0x00C6FF, size: 0.05, transparent: true, opacity: 0.5 });
  scene.add(new THREE.Points(ptGeo, ptMat));

  // Lines between boxes
  const lineMat = new THREE.LineBasicMaterial({ color: 0x0072FF, transparent: true, opacity: 0.15 });
  for (let i = 0; i < 12; i++) {
    const a = boxes[Math.floor(Math.random() * boxes.length)];
    const b = boxes[Math.floor(Math.random() * boxes.length)];
    const lg = new THREE.BufferGeometry().setFromPoints([a.position, b.position]);
    scene.add(new THREE.Line(lg, lineMat));
  }

  let mouseX = 0, mouseY = 0;
  document.addEventListener('mousemove', e => {
    mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
    mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
  });

  window.addEventListener('resize', () => {
    renderer.setSize(window.innerWidth, window.innerHeight);
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
  });

  let t = 0;
  (function animate() {
    requestAnimationFrame(animate);
    t += 0.01;
    camera.position.x += (mouseX * 1.5 - camera.position.x) * 0.02;
    camera.position.y += (-mouseY * 1.0 - camera.position.y) * 0.02;
    camera.lookAt(scene.position);
    boxes.forEach(b => {
      b.position.y += Math.sin(t + b.position.x) * 0.002;
      b.rotation.x += b.userData.vr;
      b.rotation.y += b.userData.vry;
    });
    renderer.render(scene, camera);
  })();
})();

/* ─── PARTICLE CANVAS ─── */
(function() {
  const canvas = document.getElementById('particle-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  function resize() {
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  const particles = Array.from({ length: 120 }, () => ({
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height,
    vx: (Math.random() - 0.5) * 2.5,
    vy: (Math.random() - 0.5) * 0.6,
    size: Math.random() * 2.5 + 0.5,
    hue: Math.random() > 0.5 ? '#00C6FF' : '#FF00CC',
    opacity: Math.random() * 0.7 + 0.3,
    trail: []
  }));

  function drawFrame() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = 'rgba(2,8,23,0.92)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Grid
    ctx.strokeStyle = 'rgba(0,198,255,0.05)';
    ctx.lineWidth = 0.5;
    for (let x = 0; x < canvas.width; x += 30) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
    }
    for (let y = 0; y < canvas.height; y += 30) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
    }

    particles.forEach(p => {
      p.trail.push({ x: p.x, y: p.y });
      if (p.trail.length > 18) p.trail.shift();

      // Trail
      for (let i = 1; i < p.trail.length; i++) {
        const alpha = (i / p.trail.length) * p.opacity * 0.5;
        ctx.strokeStyle = p.hue.replace(')', `,${alpha})`).replace('rgb', 'rgba').replace('#', 'rgba(').replace('00C6FF', '0,198,255').replace('FF00CC', '255,0,204');
        ctx.lineWidth = (i / p.trail.length) * p.size;
        ctx.beginPath();
        ctx.moveTo(p.trail[i-1].x, p.trail[i-1].y);
        ctx.lineTo(p.trail[i].x, p.trail[i].y);
        ctx.stroke();
      }

      // Dot
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fillStyle = p.hue === '#00C6FF'
        ? `rgba(0,198,255,${p.opacity})`
        : `rgba(255,0,204,${p.opacity})`;
      ctx.shadowColor = p.hue;
      ctx.shadowBlur = 10;
      ctx.fill();
      ctx.shadowBlur = 0;

      p.x += p.vx;
      p.y += p.vy;
      if (p.x < 0) p.x = canvas.width;
      if (p.x > canvas.width) p.x = 0;
      if (p.y < 0) p.y = canvas.height;
      if (p.y > canvas.height) p.y = 0;
    });

    // Connections
    ctx.lineWidth = 0.5;
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < 80) {
          ctx.strokeStyle = `rgba(0,198,255,${(1 - dist/80) * 0.15})`;
          ctx.beginPath();
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.stroke();
        }
      }
    }

    requestAnimationFrame(drawFrame);
  }
  drawFrame();
})();

/* ─── SCROLL ANIMATIONS ─── */
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) e.target.classList.add('visible');
  });
}, { threshold: 0.15 });

// Pipeline nodes & steps
['pn1','pn2','pn3','pn4','pn5'].forEach((id, i) => {
  const el = document.getElementById(id);
  if (el) {
    setTimeout(() => observer.observe(el), i * 100);
  }
});
['step1','step2','step3'].forEach((id, i) => {
  const el = document.getElementById(id);
  if (el) observer.observe(el);
});

// Connection lines
const lineObserver = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      setTimeout(() => document.getElementById('line1')?.classList.add('visible'), 400);
      setTimeout(() => document.getElementById('line2')?.classList.add('visible'), 600);
      setTimeout(() => document.getElementById('line3')?.classList.add('visible'), 900);
      setTimeout(() => document.getElementById('line4')?.classList.add('visible'), 1100);
    }
  });
}, { threshold: 0.2 });
const pipelineSection = document.getElementById('pipeline');
if (pipelineSection) lineObserver.observe(pipelineSection);

// Camera features
['cf1','cf2','cf3','cf4'].forEach((id, i) => {
  const el = document.getElementById(id);
  if (el) {
    const ob = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          setTimeout(() => e.target.classList.add('visible'), i * 120);
        }
      });
    }, { threshold: 0.1 });
    ob.observe(el);
  }
});

// Mod blocks
['mb1','mb2','mb3','mb4','mb5','mb6'].forEach((id, i) => {
  const el = document.getElementById(id);
  if (el) {
    const ob = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) setTimeout(() => e.target.classList.add('visible'), i * 100);
      });
    }, { threshold: 0.1 });
    ob.observe(el);
  }
});

// Stat cards
['sc1','sc2','sc3','sc4'].forEach((id, i) => {
  const el = document.getElementById(id);
  if (el) {
    const ob = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) setTimeout(() => e.target.classList.add('visible'), i * 120);
      });
    }, { threshold: 0.1 });
    ob.observe(el);
  }
});

/* ─── MOD BLOCK INTERACTION ─── */
document.querySelectorAll('.mod-block').forEach(b => {
  b.addEventListener('click', () => {
    b.classList.toggle('active');
  });
});

/* ─── CHAIN DOT ANIM ─── */
(function() {
  const arrows = document.querySelectorAll('.chain-arrow');
  arrows.forEach(a => {
    const dot = document.createElement('div');
    dot.className = 'chain-dot';
    a.appendChild(dot);
    let pos = 0;
    function move() {
      pos += 0.4;
      if (pos > a.offsetWidth) pos = 0;
      dot.style.left = pos + 'px';
      requestAnimationFrame(move);
    }
    move();
  });
})();
</script>
