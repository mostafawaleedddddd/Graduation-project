<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ModuVision Smart Software</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" href="/materials/logo2.png" type="image/x-icon">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Rajdhani:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    :root {
      --blue1: #00C6FF;
      --blue2: #0072FF;
      --purple1: #FF00CC;
      --purple2: #8E2DE2;
      --navy: #020817;
      --navy2: #050d1f;
      --glass: rgba(255,255,255,0.04);
      --glass-border: rgba(0,198,255,0.18);
      --text: #e8f4ff;
      --text-dim: rgba(232,244,255,0.55);
      --glow-blue: 0 0 30px rgba(0,198,255,0.4);
      --glow-purple: 0 0 30px rgba(255,0,204,0.35);
      --radius: 22px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background: var(--navy);
      color: var(--text);
      font-family: 'Rajdhani', sans-serif;
      overflow-x: hidden;
      cursor: default;
    }

    /* ─── CUSTOM CURSOR ─────────────────────── */
    .cursor {
      width: 12px; height: 12px;
      border-radius: 50%;
      background: var(--blue1);
      position: fixed;
      top: 0; left: 0;
      pointer-events: none;
      z-index: 9999;
      box-shadow: 0 0 18px var(--blue1), 0 0 40px rgba(0,198,255,0.5);
      transition: transform 0.1s ease;
      mix-blend-mode: screen;
    }
    .cursor-ring {
      width: 40px; height: 40px;
      border-radius: 50%;
      border: 1px solid rgba(0,198,255,0.4);
      position: fixed;
      top: 0; left: 0;
      pointer-events: none;
      z-index: 9998;
      transition: transform 0.15s ease, width 0.3s, height 0.3s;
    }

    /* ─── GRID OVERLAY ─────────────────────── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(0,198,255,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,198,255,0.03) 1px, transparent 1px);
      background-size: 60px 60px;
      pointer-events: none;
      z-index: 0;
    }

    /* ─── NAVBAR ───────────────────────────── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 60px;
      background: rgba(2,8,23,0.75);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(0,198,255,0.1);
      transition: padding 0.3s;
    }
    nav.scrolled { padding: 12px 60px; }
    .nav-logo {
      font-family: 'Orbitron', monospace;
      font-weight: 700;
      font-size: 1.2rem;
      background: linear-gradient(90deg, var(--blue1), var(--purple1));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 2px;
    }
    .nav-logo span { font-weight: 400; opacity: 0.7; }
    .nav-links {
      display: flex;
      gap: 36px;
      list-style: none;
    }
    .nav-links a {
      color: var(--text-dim);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      transition: color 0.3s;
      position: relative;
    }
    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: -4px; left: 0;
      width: 0; height: 1px;
      background: linear-gradient(90deg, var(--blue1), var(--purple1));
      transition: width 0.3s;
    }
    .nav-links a:hover { color: var(--blue1); }
    .nav-links a:hover::after { width: 100%; }
    .nav-cta {
      padding: 10px 28px;
      border-radius: 50px;
      background: linear-gradient(135deg, var(--blue2), var(--purple2));
      color: #fff;
      text-decoration: none;
      font-family: 'Orbitron', monospace;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 1px;
      box-shadow: 0 0 25px rgba(0,114,255,0.4);
      transition: box-shadow 0.3s, transform 0.2s;
    }
    .nav-cta:hover {
      box-shadow: 0 0 40px rgba(0,198,255,0.6), 0 0 80px rgba(142,45,226,0.3);
      transform: translateY(-2px);
    }

    /* ─── HERO ─────────────────────────────── */
    #hero {
      position: relative;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;
    }
    #hero-canvas {
      position: absolute;
      inset: 0;
      z-index: 1;
    }
    .hero-glow-left {
      position: absolute;
      left: -200px; top: 30%;
      width: 600px; height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0,198,255,0.12) 0%, transparent 70%);
      pointer-events: none;
      z-index: 1;
      animation: pulseGlow 4s ease-in-out infinite;
    }
    .hero-glow-right {
      position: absolute;
      right: -200px; top: 20%;
      width: 700px; height: 700px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,0,204,0.09) 0%, transparent 70%);
      pointer-events: none;
      z-index: 1;
      animation: pulseGlow 5s ease-in-out infinite reverse;
    }
    @keyframes pulseGlow {
      0%, 100% { opacity: 0.7; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.1); }
    }
    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 900px;
      padding: 0 30px;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 20px;
      border-radius: 50px;
      border: 1px solid rgba(0,198,255,0.3);
      background: rgba(0,198,255,0.08);
      font-size: 0.75rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--blue1);
      margin-bottom: 30px;
      font-family: 'Orbitron', monospace;
      animation: fadeInDown 0.8s ease forwards;
    }
    .hero-badge::before {
      content: '';
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--blue1);
      box-shadow: 0 0 10px var(--blue1);
      animation: blink 1.5s ease-in-out infinite;
    }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }
    @keyframes fadeInDown { from{opacity:0;transform:translateY(-20px)} to{opacity:1;transform:translateY(0)} }
    @keyframes fadeInUp { from{opacity:0;transform:translateY(30px)} to{opacity:1;transform:translateY(0)} }

    .hero-title {
      font-family: 'Orbitron', monospace;
      font-size: clamp(2.4rem, 5.5vw, 4.5rem);
      font-weight: 900;
      line-height: 1.1;
      margin-bottom: 24px;
      animation: fadeInUp 0.9s 0.2s ease both;
    }
    .hero-title .gradient-text {
      background: linear-gradient(90deg, var(--blue1), var(--purple1));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-sub {
      font-size: 1.15rem;
      color: var(--text-dim);
      line-height: 1.7;
      max-width: 640px;
      margin: 0 auto 44px;
      font-weight: 300;
      animation: fadeInUp 0.9s 0.4s ease both;
    }
    .hero-buttons {
      display: flex;
      gap: 20px;
      justify-content: center;
      flex-wrap: wrap;
      animation: fadeInUp 0.9s 0.6s ease both;
    }
    .btn-primary {
      padding: 16px 44px;
      border-radius: 50px;
      background: linear-gradient(135deg, var(--blue1), var(--blue2));
      color: #fff;
      text-decoration: none;
      font-family: 'Orbitron', monospace;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      box-shadow: 0 0 30px rgba(0,198,255,0.5), 0 8px 32px rgba(0,114,255,0.3);
      transition: all 0.3s;
      position: relative;
      overflow: hidden;
    }
    .btn-primary::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.15) 50%, transparent 70%);
      transform: translateX(-100%);
      transition: transform 0.5s;
    }
    .btn-primary:hover::before { transform: translateX(100%); }
    .btn-primary:hover {
      box-shadow: 0 0 50px rgba(0,198,255,0.7), 0 12px 40px rgba(0,114,255,0.5);
      transform: translateY(-3px);
    }
    .btn-secondary {
      padding: 15px 44px;
      border-radius: 50px;
      border: 1px solid rgba(255,255,255,0.2);
      background: rgba(255,255,255,0.04);
      backdrop-filter: blur(10px);
      color: var(--text);
      text-decoration: none;
      font-family: 'Orbitron', monospace;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      transition: all 0.3s;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .btn-secondary:hover {
      border-color: rgba(0,198,255,0.5);
      background: rgba(0,198,255,0.08);
      box-shadow: var(--glow-blue);
      transform: translateY(-3px);
    }
    .play-icon {
      width: 20px; height: 20px;
      border-radius: 50%;
      border: 1.5px solid rgba(255,255,255,0.5);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.6rem;
    }
    .hero-scroll {
      position: absolute;
      bottom: 40px; left: 50%;
      transform: translateX(-50%);
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      color: var(--text-dim);
      font-size: 0.7rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      animation: fadeInUp 1s 1s ease both;
    }
    .scroll-line {
      width: 1px; height: 50px;
      background: linear-gradient(180deg, rgba(0,198,255,0.7), transparent);
      animation: scrollPulse 2s ease-in-out infinite;
    }
    @keyframes scrollPulse {
      0%,100% { opacity: 0.4; transform: scaleY(1); }
      50% { opacity: 1; transform: scaleY(1.2); }
    }

    /* ─── SECTIONS COMMON ────────────────── */
    section { position: relative; z-index: 1; }
    .section-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 120px 60px;
    }
    .section-tag {
      display: inline-block;
      font-family: 'Orbitron', monospace;
      font-size: 0.65rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--blue1);
      margin-bottom: 16px;
      padding: 5px 16px;
      border: 1px solid rgba(0,198,255,0.25);
      border-radius: 50px;
      background: rgba(0,198,255,0.07);
    }
    .section-title {
      font-family: 'Orbitron', monospace;
      font-size: clamp(1.8rem, 3.5vw, 3rem);
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 20px;
    }
    .gradient-text {
      background: linear-gradient(90deg, var(--blue1), var(--purple1));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .section-desc {
      color: var(--text-dim);
      font-size: 1.05rem;
      line-height: 1.8;
      max-width: 600px;
      font-weight: 300;
    }

    /* ─── REVEAL / PIPELINE SECTION ─────── */
    #pipeline {
      background: linear-gradient(180deg, var(--navy) 0%, #030d1a 100%);
    }
    .pipeline-wrapper {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }
    .pipeline-visual {
      position: relative;
      height: 480px;
    }
    #pipeline-canvas { width: 100%; height: 100%; }
    .pipeline-nodes {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .p-node {
      position: absolute;
      background: var(--glass);
      border: 1px solid var(--glass-border);
      backdrop-filter: blur(16px);
      border-radius: var(--radius);
      padding: 18px 22px;
      display: flex;
      align-items: center;
      gap: 14px;
      opacity: 0;
      transform: scale(0.85) translateY(10px);
      transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    }
    .p-node.visible {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    .p-node:hover {
      border-color: rgba(0,198,255,0.5);
      box-shadow: var(--glow-blue), 0 8px 32px rgba(0,0,0,0.4);
    }
    .p-node-icon {
      width: 42px; height: 42px;
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem;
    }
    .p-node-info h4 {
      font-family: 'Orbitron', monospace;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 1px;
      margin-bottom: 3px;
    }
    .p-node-info p { font-size: 0.8rem; color: var(--text-dim); }
    .n1 { top: 10px; left: 10px; }
    .n2 { top: 42%; left: 50%; transform: translateX(-50%) scale(0.85) translateY(10px) !important; }
    .n2.visible { transform: translateX(-50%) scale(1) translateY(0) !important; }
    .n3 { top: 10px; right: 10px; }
    .n4 { bottom: 10px; left: 10px; }
    .n5 { bottom: 10px; right: 10px; }

    .connector-svg {
      position: absolute;
      inset: 0;
      width: 100%; height: 100%;
      pointer-events: none;
      overflow: visible;
    }
    .conn-line {
      fill: none;
      stroke: url(#lineGrad);
      stroke-width: 1.5;
      stroke-dasharray: 6 4;
      opacity: 0;
      transition: opacity 0.5s;
    }
    .conn-line.visible { opacity: 1; animation: dashMove 3s linear infinite; }
    @keyframes dashMove { to { stroke-dashoffset: -100; } }

    /*.pipeline-info { }*/
    .pipeline-steps { margin-top: 40px; display: flex; flex-direction: column; gap: 20px; }
    .step-item {
      display: flex;
      gap: 20px;
      align-items: flex-start;
      padding: 20px;
      border-radius: var(--radius);
      border: 1px solid transparent;
      background: var(--glass);
      backdrop-filter: blur(10px);
      opacity: 0;
      transform: translateX(30px);
      transition: all 0.5s ease;
    }
    .step-item.visible {
      opacity: 1;
      transform: translateX(0);
    }
    .step-item:hover {
      border-color: rgba(0,198,255,0.2);
      background: rgba(0,198,255,0.06);
    }
    .step-num {
      font-family: 'Orbitron', monospace;
      font-size: 1.5rem;
      font-weight: 900;
      background: linear-gradient(135deg, var(--blue1), var(--purple1));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      min-width: 40px;
      line-height: 1;
    }
    .step-text h4 {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 4px;
      letter-spacing: 0.5px;
    }
    .step-text p { font-size: 0.88rem; color: var(--text-dim); }

    /* ─── CAMERA SECTION ─────────────────── */
    #camera {
      background: linear-gradient(180deg, #030d1a 0%, #06091a 100%);
    }
    .camera-wrapper {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }
    .camera-mockup {
      position: relative;
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid rgba(0,198,255,0.2);
      box-shadow: var(--glow-blue), 0 30px 80px rgba(0,0,0,0.6);
    }
    .camera-screen {
      background: #0a1628;
      aspect-ratio: 16/10;
      position: relative;
      overflow: hidden;
    }
    .cam-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(0,198,255,0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,198,255,0.06) 1px, transparent 1px);
      background-size: 30px 30px;
    }
    .cam-scanline {
      position: absolute;
      left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgba(0,198,255,0.5), transparent);
      animation: scanline 4s linear infinite;
    }
    @keyframes scanline {
      0% { top: 0; opacity: 0.8; }
      100% { top: 100%; opacity: 0; }
    }
    .cam-corner {
      position: absolute;
      width: 18px; height: 18px;
      border-color: var(--blue1);
      border-style: solid;
      opacity: 0.7;
    }
    .cam-corner.tl { top: 10px; left: 10px; border-width: 2px 0 0 2px; }
    .cam-corner.tr { top: 10px; right: 10px; border-width: 2px 2px 0 0; }
    .cam-corner.bl { bottom: 10px; left: 10px; border-width: 0 0 2px 2px; }
    .cam-corner.br { bottom: 10px; right: 10px; border-width: 0 2px 2px 0; }

    .detection-box {
      position: absolute;
      border: 1.5px solid;
      border-radius: 4px;
      padding: 4px 8px;
      font-size: 0.6rem;
      font-family: 'Orbitron', monospace;
      letter-spacing: 1px;
      opacity: 0;
      animation: detectionAppear 2s ease-in-out infinite;
    }
    .db1 { top: 20%; left: 15%; border-color: #00ff88; color: #00ff88; width: 100px; height: 90px; animation-delay: 0s; }
    .db2 { top: 35%; right: 20%; border-color: var(--blue1); color: var(--blue1); width: 80px; height: 70px; animation-delay: 0.8s; }
    .db3 { bottom: 20%; left: 30%; border-color: var(--purple1); color: var(--purple1); width: 70px; height: 60px; animation-delay: 1.4s; }
    @keyframes detectionAppear {
      0% { opacity: 0; transform: scale(0.95); }
      20% { opacity: 1; transform: scale(1); }
      80% { opacity: 1; transform: scale(1); }
      100% { opacity: 0; transform: scale(0.95); }
    }
    .db-label {
      position: absolute;
      bottom: -1px; left: -1px;
      background: currentColor;
      color: #000;
      font-size: 0.5rem;
      padding: 1px 4px;
      font-weight: 700;
    }
    .cam-live {
      position: absolute;
      top: 12px; right: 14px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Orbitron', monospace;
      font-size: 0.6rem;
      color: #ff4444;
      letter-spacing: 1px;
    }
    .live-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: #ff4444;
      animation: blink 1s infinite;
    }
    .cam-stats {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1px;
      background: rgba(0,198,255,0.1);
    }
    .cam-stat {
      background: rgba(2,8,23,0.9);
      padding: 12px 16px;
      text-align: center;
    }
    .cam-stat-val {
      font-family: 'Orbitron', monospace;
      font-size: 1.1rem;
      font-weight: 700;
      background: linear-gradient(90deg, var(--blue1), var(--purple1));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .cam-stat-label { font-size: 0.65rem; color: var(--text-dim); letter-spacing: 1px; margin-top: 2px; }

    .floating-alerts {
      position: absolute;
      right: -180px; top: 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .alert-pill {
      background: var(--glass);
      border: 1px solid var(--glass-border);
      backdrop-filter: blur(16px);
      border-radius: 50px;
      padding: 8px 18px;
      font-size: 0.72rem;
      font-family: 'Orbitron', monospace;
      letter-spacing: 0.5px;
      white-space: nowrap;
      opacity: 0;
      transform: translateX(20px);
      animation: alertAppear 3s ease-in-out infinite;
    }
    .alert-pill:nth-child(1) { animation-delay: 0s; border-color: rgba(0,255,136,0.3); color: #00ff88; }
    .alert-pill:nth-child(2) { animation-delay: 1s; border-color: rgba(0,198,255,0.3); color: var(--blue1); }
    .alert-pill:nth-child(3) { animation-delay: 2s; border-color: rgba(255,0,204,0.3); color: var(--purple1); }
    @keyframes alertAppear {
      0%,90%,100% { opacity: 0; transform: translateX(20px); }
      15%,75% { opacity: 1; transform: translateX(0); }
    }

    /*.camera-info { }*/
    .cam-features { display: flex; flex-direction: column; gap: 16px; margin-top: 36px; }
    .cam-feat {
      display: flex; gap: 16px; align-items: center;
      padding: 16px 20px;
      background: var(--glass);
      border: 1px solid transparent;
      border-radius: 14px;
      backdrop-filter: blur(10px);
      opacity: 0;
      transform: translateX(-20px);
      transition: all 0.5s ease;
    }
    .cam-feat.visible { opacity: 1; transform: translateX(0); }
    .cam-feat:hover { border-color: rgba(0,198,255,0.2); }
    .cam-feat-icon {
      width: 38px; height: 38px;
      border-radius: 10px;
      background: linear-gradient(135deg, rgba(0,198,255,0.15), rgba(0,114,255,0.15));
      border: 1px solid rgba(0,198,255,0.2);
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem;
      flex-shrink: 0;
    }
    .cam-feat h4 { font-size: 0.92rem; font-weight: 600; margin-bottom: 2px; }
    .cam-feat p { font-size: 0.8rem; color: var(--text-dim); }

    /* ─── MODULARITY SECTION ─────────────── */
    #modularity {
      background: linear-gradient(180deg, #06091a 0%, #030a17 100%);
    }
    .mod-wrapper { text-align: center; }
    .mod-blocks {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      justify-content: center;
      margin: 60px 0;
    }
    .mod-block {
      background: var(--glass);
      border: 1px solid var(--glass-border);
      backdrop-filter: blur(20px);
      border-radius: var(--radius);
      padding: 28px 32px;
      min-width: 200px;
      text-align: center;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      opacity: 0;
      transform: translateY(30px) scale(0.9);
      position: relative;
      overflow: hidden;
    }
    .mod-block.visible {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    .mod-block::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, transparent, rgba(0,198,255,0.05));
      opacity: 0;
      transition: opacity 0.3s;
    }
    .mod-block:hover {
      transform: translateY(-8px) scale(1.02);
      border-color: rgba(0,198,255,0.4);
      box-shadow: var(--glow-blue);
    }
    .mod-block:hover::before { opacity: 1; }
    .mod-block.active {
      border-color: rgba(0,198,255,0.6);
      box-shadow: var(--glow-blue), inset 0 0 30px rgba(0,198,255,0.05);
    }
    .mod-icon { font-size: 2rem; margin-bottom: 12px; display: block; }
    .mod-name {
      font-family: 'Orbitron', monospace;
      font-size: 0.72rem;
      letter-spacing: 1.5px;
      font-weight: 600;
      color: var(--blue1);
      margin-bottom: 6px;
    }
    .mod-desc { font-size: 0.8rem; color: var(--text-dim); }
    .snap-indicator {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      margin: 20px 0;
      font-size: 0.75rem;
      color: var(--text-dim);
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    .snap-arrow { color: var(--blue1); font-size: 1.2rem; animation: arrowPulse 1.5s ease-in-out infinite; }
    @keyframes arrowPulse { 0%,100%{transform:translateX(0);opacity:0.5} 50%{transform:translateX(4px);opacity:1} }
    .chain-visual {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      padding: 30px;
      background: var(--glass);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      backdrop-filter: blur(16px);
      margin-top: 30px;
      overflow-x: auto;
    }
    .chain-node {
      background: linear-gradient(135deg, rgba(0,198,255,0.1), rgba(0,114,255,0.1));
      border: 1px solid rgba(0,198,255,0.3);
      border-radius: 12px;
      padding: 12px 20px;
      font-family: 'Orbitron', monospace;
      font-size: 0.65rem;
      letter-spacing: 1px;
      color: var(--blue1);
      white-space: nowrap;
      transition: all 0.3s;
    }
    .chain-node:hover {
      border-color: var(--blue1);
      box-shadow: var(--glow-blue);
    }
    .chain-arrow {
      width: 40px; height: 2px;
      background: linear-gradient(90deg, var(--blue1), var(--purple1));
      position: relative;
      flex-shrink: 0;
    }
    .chain-arrow::after {
      content: '';
      position: absolute;
      right: -4px; top: -4px;
      width: 10px; height: 10px;
      border-top: 2px solid var(--purple1);
      border-right: 2px solid var(--purple1);
      transform: rotate(45deg);
    }
    .chain-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--blue1);
      box-shadow: 0 0 12px var(--blue1);
      animation: moveDot 3s linear infinite;
      position: absolute;
      top: -3px;
    }
    .chain-arrow { position: relative; overflow: visible; }

    /* ─── PERFORMANCE SECTION ─────────────── */
    #performance {
      background: linear-gradient(180deg, #030a17 0%, var(--navy) 100%);
      overflow: hidden;
    }
    .perf-wrapper {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }
    #particle-canvas {
