<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ModuVision</title>
    <link rel="stylesheet" href="/css/Dashboard.css">
    <link rel="icon" href="/materials/logo2.png" type="image/x-icon">
</head>

<body>

    <!-- Navbar -->
    <div class="navbar">
        <div class="navbar-left"></div>

        <div class="navbar-center">
            <div class="navbar-title">ModuVision</div>
        </div>

        <div class="navbar-right">
            <div class="navbar-logo">
                <img src="/materials/logo.png" alt="ModuVision Logo" draggable="false">
            </div>
            <button type="button" id="logoutBtn" class="logout-btn">Logout</button>
        </div>
    </div>

    <div class="container">

        <!-- Sidebar -->
        <div class="sidebar">
            <h3>Functions</h3>
            <div style="display: flex; align-items: center; gap: 8px;">
                <select id="projectSelect" class="live-feed-select">
                    <option value="">Select Project</option>
                </select>
                <button type="button" id="deleteProjectBtn" class="delete-btn" onclick="deleteSelectedProject()">🗑️</button>
            </div>

            <div class="functionality" draggable="true" data-type="Color Detection">
                🎨 Color Detection
            </div>
            <div class="functionality" draggable="true" data-type="Tracking">
                🎯 Tracking
            </div>
            <div class="functionality" draggable="true" data-type="Object Counting">
                🔢 Object Counting
            </div>
            <div class="functionality" draggable="true" data-type="Gap Detection">
                🧱 Gap Detection
            </div>
            <div class="functionality" draggable="true" data-type="Attendance">
                🪪 Attendance
            </div>
            <div class="functionality" draggable="true" data-type="Security">
                🔒 Security Alert
            </div>
            <div class="functionality" draggable="true" data-type="Parking Management">
                🅿️ Parking Management
            </div>
            <div class="functionality" draggable="true" data-type="Heatmap">
                🌡️ Heatmap
            </div>
            <div class="functionality" draggable="true" data-type="Fire & Smoke Detection">
                🔥 Fire & Smoke Detection
            </div>
        </div>

        <!-- Info Modal -->
        <div id="infoModal" class="modal-overlay">
            <div class="modal-content window-panel">
                <button type="button" class="close-btn window-close" onclick="closeInfoModal()">&times;</button>
                <h3 id="infoModalTitle">Notification</h3>
                <div id="infoModalContent" class="modal-scroll-area"></div>
                <div class="action-buttons window-actions">
                    <button type="button" class="btn-primary" onclick="closeInfoModal()">OK</button>
                </div>
            </div>
        </div>

        <!-- Canvas -->
        <div class="canvas-wrapper">
            <div class="canvas" id="canvas">
                <svg id="connectionSvg">
                    <defs>
                        <linearGradient id="lineGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#00C6FF" />
                            <stop offset="100%" style="stop-color:#FF00CC" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>
        </div>

        <!-- Live Feed Panel -->
        <div class="live-feed-panel">
            <div class="live-feed-title">
                <div class="live-feed-status">
                    <div class="live-feed-dot"></div>
                    <div class="live-feed-heading">
                        <span class="live-feed-kicker">Live Feed</span>
                        <span id="liveFeedSubtext" class="live-feed-subtext">Select a camera to start streaming</span>
                    </div>
                </div>
                <div class="live-feed-buttons">
                    <div class="camera-dropdown-wrapper">
                        <button type="button" id="cameraDropdownToggle" class="live-feed-select camera-dropdown-toggle">
                            <span id="cameraDropdownLabel">Select Camera</span>
                            <span class="camera-dropdown-caret">▼</span>
                        </button>
                        <div id="cameraDropdownMenu" class="camera-dropdown-menu"></div>
                        <select id="cameraSelect" class="camera-select-native" aria-hidden="true" tabindex="-1">
                            <option value="">Select Camera</option>
                        </select>
                    </div>
                    <button type="button" class="live-feed-btn" onclick="openAddCamera()">➕ Add</button>
                    <button type="button" class="live-feed-btn" onclick="saveProject()">💾 Save</button>
                    <button type="button" class="live-feed-btn" onclick="uploadProject()">📤 Upload</button>
                    <div class="split-dropdown-wrapper">
                        <button type="button" class="live-feed-btn split-btn" id="splitBtn" onclick="toggleSplitMenu()">⊞ Split</button>
                        <div class="split-dropdown-menu" id="splitDropdownMenu">
                            <button type="button" onclick="setSplitMode(1)">Single View</button>
                            <button type="button" onclick="setSplitMode(2)">2 Cameras</button>
                            <button type="button" onclick="setSplitMode(3)">3 Cameras</button>
                            <button type="button" onclick="setSplitMode(4)">4 Cameras</button>
                        </div>
                    </div>
                    <input id="attendanceUploadInput" type="file" accept="image/*" style="display:none" multiple>
                </div>
            </div>
            <div class="live-feed-content" id="liveFeedContent">
                <!-- Single view (default) -->
                <div id="liveFeedPlaceholder" class="live-feed-placeholder show">
                    <span class="live-feed-placeholder-title">Camera idle</span>
                    <span class="live-feed-placeholder-text">Choose a saved camera or add a new one to begin the stream.</span>
                    <div class="resize-hint">Drag the top-left corner to resize this panel.</div>
                    <div class="resize-grip" title="Drag to resize"></div>
                </div>
                <img id="live-feed" alt="Live Camera Feed">

                <!-- Split grid (hidden by default) -->
                <div class="split-grid" id="splitGrid"></div>

                <!-- Focused panel (when user clicks a split cell) -->
                <div class="split-focus-overlay" id="splitFocusOverlay">
                    <button class="split-focus-back" id="splitFocusBack" onclick="exitFocusMode()">← Back to Split</button>
                    <img class="split-focus-img" id="splitFocusImg" alt="Focused Feed">
                    <div class="split-focus-placeholder" id="splitFocusPlaceholder">
                        <span>No camera selected</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Save Project Modal -->
        <div id="saveProjectModal" class="modal-overlay">
            <div class="modal-content window-panel">
                <button type="button" class="close-btn window-close" onclick="closeSaveModal()">&times;</button>
                <h3>Save Project</h3>
                <div class="input-group">
                    <input type="text" id="projectNameInput" placeholder="Enter project name..." autocomplete="off">
                </div>
                <div class="action-buttons window-actions">
                    <button type="button" class="btn-secondary" onclick="closeSaveModal()">Cancel</button>
                    <button type="button" class="btn-primary" onclick="confirmSaveProject()">Save</button>
                </div>
            </div>
        </div>

    </div>

    <!-- Add Camera Modal -->
    <div id="cameraModal" class="modal-overlay">
        <div class="modal-content">
            <button type="button" class="close-btn" onclick="closeAddCamera()">&times;</button>
            <h3>Add IP Camera</h3>
            <div class="input-group">
                <input type="text" id="cameraName" placeholder="Camera Name">
            </div>
            <div class="input-group">
                <input type="text" id="cameraUrl" placeholder="RTSP / HTTP URL">
            </div>
            <div class="action-buttons">
                <button type="button" class="btn-secondary" onclick="closeAddCamera()">Cancel</button>
                <button type="button" class="btn-primary" onclick="addCamera()">Add Camera</button>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         ATTENDANCE CLASS MODAL
         Only shown when Attendance is solo on canvas
    ════════════════════════════════════════════════ -->
    <div id="attendanceClassModal" class="modal-overlay">
        <div class="modal-content attendance-class-modal-content">
            <button type="button" class="close-btn" onclick="closeAttendanceClassModal()">&times;</button>
            <h3>🪪 Add Attendance Class</h3>

            <div class="input-group">
                <label class="att-label">Class Name</label>
                <input type="text" id="attendanceClassName" placeholder="e.g. Class A, Grade 5B..." autocomplete="off">
            </div>

            <div class="input-group">
                <label class="att-label">Student Photos <span class="att-label-hint">(select multiple)</span></label>
                <div class="att-upload-zone" id="attUploadZone" onclick="document.getElementById('attImageInput').click()">
                    <div class="att-upload-icon">📁</div>
                    <div class="att-upload-text">Click to browse or drag &amp; drop images</div>
                    <div class="att-upload-hint">JPG, PNG, WEBP — up to 10 MB each</div>
                </div>
                <input type="file" id="attImageInput" multiple accept="image/*" style="display:none">
            </div>

            <!-- Preview thumbnails -->
            <div id="attImagePreview" class="att-image-preview"></div>

            <div id="attClassError" class="att-error" style="display:none;"></div>

            <div class="action-buttons">
                <button type="button" class="btn-secondary" onclick="closeAttendanceClassModal()">Cancel</button>
                <button type="button" class="btn-primary" id="attSaveBtn" onclick="saveAttendanceClass()">
                    <span id="attSaveBtnText">Save Class</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Split Camera Selection Modal -->
    <div id="splitUploadModal" class="modal-overlay">
        <div class="modal-content window-panel">
            <button type="button" class="close-btn window-close" onclick="closeSplitUploadModal()">&times;</button>
            <h3>Select Cameras</h3>
            <p class="split-upload-subtitle">Choose which cameras to apply the pipeline to:</p>
            <div id="splitUploadCameraList" class="split-upload-camera-list"></div>
            <div class="action-buttons window-actions">
                <button type="button" class="btn-secondary" onclick="closeSplitUploadModal()">Cancel</button>
                <button type="button" class="btn-primary" onclick="confirmSplitUpload()">✔ Apply</button>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         FIRE / SMOKE ALERT TOASTS
         Fixed position — no overlay, no background blur.
         Shown/hidden entirely by Dashboard.js polling.
    ════════════════════════════════════════════════ -->
    <div id="fireAlertToast" class="fire-toast fire-toast--fire" style="display:none;">
        <span class="fire-toast-icon">🔥</span>
        <div class="fire-toast-body">
            <span class="fire-toast-title">FIRE DETECTED</span>
            <span class="fire-toast-sub" id="fireAlertSub">Continuous detection for 3 seconds</span>
        </div>
        <button class="fire-toast-dismiss" onclick="dismissFireToast('fire')" title="Dismiss">✕</button>
    </div>

    <div id="smokeAlertToast" class="fire-toast fire-toast--smoke" style="display:none;">
        <span class="fire-toast-icon">🌫️</span>
        <div class="fire-toast-body">
            <span class="fire-toast-title">SMOKE DETECTED</span>
            <span class="fire-toast-sub" id="smokeAlertSub">Continuous detection for 5 seconds</span>
        </div>
        <button class="fire-toast-dismiss" onclick="dismissFireToast('smoke')" title="Dismiss">✕</button>
    </div>

    <style>
        /* ── Fire toast (no modal overlay, no blur) ── */
        .fire-toast {
            position: fixed;
            top: 72px;       /* below navbar */
            right: 20px;
            z-index: 9999;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px 14px 14px;
            border-radius: 10px;
            min-width: 280px;
            max-width: 360px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.55);
            animation: fireToastIn 0.3s ease;
            border: 1px solid rgba(255,255,255,0.08);
        }
        .fire-toast + .fire-toast {
            top: 148px;   /* stack second toast below first */
        }
        .fire-toast--fire {
            background: linear-gradient(135deg, #7a1a00 0%, #c0380a 100%);
            color: #fff;
        }
        .fire-toast--smoke {
            background: linear-gradient(135deg, #2a2a2a 0%, #4a4a4a 100%);
            color: #ddd;
        }
        .fire-toast-icon {
            font-size: 28px;
            flex-shrink: 0;
            animation: fireIconPulse 1s ease-in-out infinite alternate;
        }
        .fire-toast-body {
            display: flex;
            flex-direction: column;
            gap: 3px;
            flex: 1;
        }
        .fire-toast-title {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.05em;
        }
        .fire-toast-sub {
            font-size: 12px;
            opacity: 0.8;
        }
        .fire-toast-dismiss {
            background: none;
            border: none;
            color: inherit;
            cursor: pointer;
            font-size: 16px;
            opacity: 0.65;
            padding: 2px 4px;
            flex-shrink: 0;
            transition: opacity 0.15s;
        }
        .fire-toast-dismiss:hover { opacity: 1; }

        @keyframes fireToastIn {
            from { opacity: 0; transform: translateX(40px); }
            to   { opacity: 1; transform: translateX(0);    }
        }
        @keyframes fireIconPulse {
            from { transform: scale(1);    }
            to   { transform: scale(1.15); }
        }
    </style>

    <script src="/scripts/Dashboard.js"></script>
</body>

</html>
