<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ModuVision</title>
    <link rel="stylesheet" href="/css/Dashboard.css">
    <link rel="icon" href="/materials/logo2.png" type="image/x-icon">
</head>

<body>

    <!-- Navbar -->
    <div class="navbar">
        <div class="navbar-left"></div>

        <div class="navbar-center">
            <div class="navbar-title">ModuVision</div>
        </div>

        <div class="navbar-right">
            <div class="navbar-logo">
                <img src="/materials/logo.png" alt="ModuVision Logo" draggable="false">
            </div>
            <button id="logoutBtn" class="logout-btn">Logout</button>
        </div>
    </div>

    <div class="container">

        <!-- Sidebar -->
        <div class="sidebar">
            <h3>Functions</h3>
            <select id="projectSelect" class="live-feed-select">
                <option value="">Select Project</option>
            </select>


            <div class="functionality" draggable="true" data-type="Object Detection">
                👁️ Object Detection
            </div>

            <div class="functionality" draggable="true" data-type="Color Detection">
                🎨 Color Detection
            </div>

            <div class="functionality" draggable="true" data-type="Tracking">
                🎯 Tracking
            </div>
            <div class="functionality" draggable="true" data-type="Object Counting">
                🔢 Object Counting</div>
            <div class="functionality" draggable="true" data-type="Gap Detection">
                🧱 Gap Detection</div>
            <div class="functionality" draggable="true" data-type="Attendance">
                � Attendance
            </div>
            <div class="functionality" draggable="true" data-type="Parking Management">
                🅿️ Parking Management
            </div>
            <div class="functionality" draggable="true" data-type="Heatmap">
                🌡️ Heatmap
            </div>
        </div>


        <div id="infoModal" class="modal-overlay">
            <div class="modal-content window-panel">

                <div class="window-header">
                    <button class="close-btn window-close" onclick="closeInfoModal()">&times;</button>
                </div>

                <div class="window-body">
                    <h3 id="infoModalTitle">Notification</h3>

                    <div id="infoModalContent" class="modal-scroll-area">
                    </div>

                    <div class="action-buttons window-actions">
                        <button class="btn-primary" onclick="closeInfoModal()">OK</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Canvas -->
        <div class="canvas-wrapper">
            <div class="canvas" id="canvas">
                <svg id="connectionSvg">
                    <defs>
                        <linearGradient id="lineGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#6496ff" />
                            <stop offset="100%" style="stop-color:#9334ea" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>
        </div>

        <!-- Live Feed Panel -->
        <div class="live-feed-panel">
            <div class="live-feed-title">
                <div style="display:flex;align-items:center;gap:8px;">
                    <div class="live-feed-dot"></div>
                    Live Feed
                </div>

                <div class="live-feed-buttons">
                    <select id="cameraSelect" class="live-feed-select">
                        <option value="">Select Camera</option>
                    </select>

                    <button class="live-feed-btn" onclick="openAddCamera()">➕ Add</button>
                    <button class="live-feed-btn" onclick="saveProject()">💾 Save</button>
                    <button class="live-feed-btn" onclick="uploadProject()">📤 Upload</button>
                </div>
            </div>

            <div class="live-feed-content">
                <!-- CAMERA FEED -->
                <img id="live-feed" src="http://127.0.0.1:5000/video" alt="Live Camera Feed"
                    style="width: 100%; height: auto; border-radius: 12px;">
            </div>
        </div>
        <div id="saveProjectModal" class="modal-overlay">
            <div class="modal-content window-panel">

                <div class="window-header">
                    <button class="close-btn window-close" onclick="closeSaveModal()">&times;</button>
                </div>

                <div class="window-body">
                    <h3>Save Project</h3>

                    <div class="input-group">
                        <input type="text" id="projectNameInput" placeholder="Enter project name..." autocomplete="off">
                    </div>

                    <div class="action-buttons window-actions">
                        <button class="btn-secondary" onclick="closeSaveModal()">Cancel</button>
                        <button class="btn-primary" onclick="confirmSaveProject()">Save</button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div id="cameraModal" class="modal-overlay">
        <div class="modal-content">
            <button class="close-btn" onclick="closeAddCamera()">&times;</button>

            <h3>Add IP Camera</h3>

            <div class="input-group">
                <input type="text" id="cameraName" placeholder="Camera Name">
            </div>

            <div class="input-group">
                <input type="text" id="cameraUrl" placeholder="RTSP / HTTP URL">
            </div>

            <div class="action-buttons">
                <button class="btn-secondary" onclick="closeAddCamera()">Cancel</button>
                <button class="btn-primary" onclick="addCamera()">Add Camera</button>
            </div>
        </div>
    </div>
    <script src="/scripts/Dashboard.js"></script>
</body>

</html>